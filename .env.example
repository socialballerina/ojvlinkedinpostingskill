# Copy to .env.local for local dev. In production set these in Vercel:
# Project Settings -> Environment Variables. Never commit real values.
#
# NOTE: the Anthropic credential does NOT live here. Claude runs in GitHub
# Actions, authenticated by the ANTHROPIC_API_KEY secret on the GitHub repo.
# Vercel only starts runs and reads back results.

# Required. Shared password the intern types once. Any long random string.
APP_PASSWORD=change-me-to-something-long

# Optional. Fine-grained GitHub token, scoped to this repository only, with
# Actions: Read and write. Only needed for the on-demand button; without it the
# Thursday schedule still runs and the page still shows results, because the
# repository is public.
GITHUB_TOKEN=github_pat_...

# Optional overrides.
# GITHUB_REPO=socialballerina/ojvlinkedinpostingskill
# GITHUB_WORKFLOW_FILE=generate-week.yml
# GITHUB_BRANCH=main
