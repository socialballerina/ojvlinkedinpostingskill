# Copy to .env.local for local dev. In production set these in Vercel:
# Project Settings -> Environment Variables. Never commit real values.
#
# NOTE: there is no ANTHROPIC_API_KEY. The model runs in GitHub Actions,
# authenticated by the CLAUDE_CODE_OAUTH_TOKEN secret on the GitHub repo,
# which is billed to a Claude subscription.

# Required. Shared password the intern types once. Any long random string.
APP_PASSWORD=change-me-to-something-long

# Required. Fine-grained GitHub token, scoped to this repository only, with:
#   Actions:  Read and write   (to start the workflow)
#   Contents: Read-only        (to read back the generated posts)
GITHUB_TOKEN=github_pat_...

# Optional overrides.
# GITHUB_REPO=socialballerina/ojvlinkedinpostingskill
# GITHUB_WORKFLOW_FILE=generate-week.yml
# GITHUB_BRANCH=main
